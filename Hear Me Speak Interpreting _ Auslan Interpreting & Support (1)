.brand-logo { width: 50px; height: 50px; object-fit: cover; border-radius: 10px; }

.brand strong { display: block; font-size: 1rem; letter-spacing: 0.02em; }

.brand small { display: block; opacity: 0.62; letter-spacing: 0.18em; font-size: 0.63rem; }

.site-nav { display: flex; align-items: center; gap: 28px; }

.site-nav a { text-decoration: none; font-size: 0.92rem; opacity: 0.88; }

.site-nav a:hover { opacity: 1; }

.nav-cta { padding: 10px 15px; border: 1px solid rgba(255, 255, 255, 0.35); border-radius: 999px; }

.menu-toggle { display: none; background: transparent; border: 0px; color: white; padding: 8px; }

.menu-toggle span:not(.sr-only) { display: block; width: 24px; height: 2px; background: white; margin: 5px; }

.hero { background: var(--ink); color: var(--white); padding: 92px 0px 82px; overflow: hidden; }

.hero-grid { display: grid; grid-template-columns: 1.12fr 0.88fr; gap: 70px; align-items: center; }

.eyebrow { margin: 0px 0px 12px; text-transform: uppercase; letter-spacing: 0.18em; font-size: 0.74rem; font-weight: 800; color: var(--accent-dark); }

.hero .eyebrow { color: var(--accent); }

h1, h2, h3 { line-height: 1.12; margin-top: 0px; }

h1 { font-size: clamp(3rem, 7vw, 5.8rem); letter-spacing: -0.055em; margin-bottom: 24px; max-width: 800px; }

h2 { font-size: clamp(2rem, 4vw, 3.4rem); letter-spacing: -0.04em; }

h3 { font-size: 1.18rem; }

.hero-lead { max-width: 680px; font-size: clamp(1.05rem, 2vw, 1.28rem); color: rgba(255, 255, 255, 0.76); }

.hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin: 32px 0px 34px; }

.button { display: inline-flex; justify-content: center; align-items: center; min-height: 48px; padding: 0px 20px; border-radius: 999px; border: 1px solid transparent; font-weight: 800; text-decoration: none; cursor: pointer; }

.button-primary { background: var(--accent); color: var(--ink); }

.button-primary:hover { transform: translateY(-1px); }

.button-secondary { border-color: rgba(255, 255, 255, 0.28); color: white; }

.trust-row { display: flex; flex-wrap: wrap; gap: 8px; }

.trust-row span { border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 999px; padding: 7px 11px; font-size: 0.76rem; color: rgba(255, 255, 255, 0.72); }

.hero-card { background: rgb(0, 0, 0); border: 1px solid rgba(255, 255, 255, 0.13); border-radius: 30px; overflow: hidden; box-shadow: var(--shadow); }

.hero-logo { width: 100%; aspect-ratio: 1 / 0.85; object-fit: cover; }

.hero-card-caption { padding: 18px 20px 22px; }

.hero-card-caption strong { display: block; }

.hero-card-caption span { color: rgba(255, 255, 255, 0.6); font-size: 0.88rem; }

.section { padding: 100px 0px; }

.section-heading { max-width: 760px; margin-bottom: 48px; }

.section-heading p:not(.eyebrow) { color: var(--muted); font-size: 1.05rem; }

.cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }

.card { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; min-height: 230px; }

.card p { color: var(--muted); margin-bottom: 0px; }

.icon { display: inline-flex; align-items: center; justify-content: center; width: 42px; height: 42px; border-radius: 12px; background: var(--ink); color: var(--accent); font-weight: 900; font-size: 0.78rem; margin-bottom: 24px; }

.section-dark { background: var(--ink); color: white; }

.split { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 80px; }

.about-copy { color: rgba(255, 255, 255, 0.72); font-size: 1.06rem; }

.about-copy p { margin-top: 0px; margin-bottom: 22px; }

.sector-grid { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--line); }

.sector { padding: 24px 0px; border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: 4px; }

.sector:nth-child(2n+1) { padding-right: 35px; border-right: 1px solid var(--line); }

.sector:nth-child(2n) { padding-left: 35px; }

.sector span { color: var(--muted); font-size: 0.92rem; }

.process-section { background: rgb(236, 233, 226); }

.process { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }

.process-step { position: relative; padding-top: 58px; }

.process-step > span { position: absolute; top: 0px; left: 0px; width: 42px; height: 42px; display: grid; place-items: center; border-radius: 50%; background: var(--ink); color: var(--accent); font-weight: 900; }

.process-step p { color: var(--muted); }

.contact-section { background: var(--white); }

.contact-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 80px; align-items: start; }

.contact-grid > div > p:not(.eyebrow) { color: var(--muted); font-size: 1.05rem; }

.contact-note { margin-top: 28px; padding: 18px; border-left: 4px solid var(--accent); background: var(--paper); font-size: 0.9rem; }

.contact-form { display: grid; gap: 16px; padding: 30px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper); }

.contact-form label { display: grid; gap: 7px; font-weight: 750; font-size: 0.88rem; }

input, select, textarea { width: 100%; border: 1px solid rgb(203, 200, 192); border-radius: 12px; background: white; padding: 13px 14px; font: inherit; color: var(--ink); }

input:focus, select:focus, textarea:focus { outline: rgba(241, 200, 75, 0.35) solid 3px; border-color: var(--accent-dark); }

textarea { resize: vertical; }

.form-status { margin: 0px; color: var(--muted); font-size: 0.86rem; }

.site-footer { background: rgb(10, 10, 10); color: white; padding: 48px 0px 22px; }

.footer-wrap { display: flex; justify-content: space-between; gap: 30px; }

.footer-wrap p { color: rgba(255, 255, 255, 0.55); margin: 5px 0px 0px; font-size: 0.9rem; }

.footer-links { display: flex; gap: 20px; }

.footer-links a { color: rgba(255, 255, 255, 0.72); text-decoration: none; }

.copyright { border-top: 1px solid rgba(255, 255, 255, 0.1); margin-top: 35px; padding-top: 18px; display: flex; justify-content: space-between; gap: 20px; color: rgba(255, 255, 255, 0.42); font-size: 0.75rem; }

.sr-only { position: absolute; width: 1px; height: 1px; padding: 0px; margin: -1px; overflow: hidden; clip: rect(0px, 0px, 0px, 0px); white-space: nowrap; border: 0px; }

@media (max-width: 850px) {
  .menu-toggle { display: block; }
  .site-nav { display: none; position: absolute; top: 78px; left: 0px; right: 0px; padding: 20px; background: var(--ink); border-top: 1px solid rgba(255, 255, 255, 0.1); flex-direction: column; align-items: stretch; }
  .site-nav.open { display: flex; }
  .site-nav a { padding: 10px 0px; }
  .hero-grid, .split, .contact-grid { grid-template-columns: 1fr; }
  .hero { padding-top: 65px; }
  .cards { grid-template-columns: repeat(2, 1fr); }
  .process { grid-template-columns: 1fr; gap: 24px; }
}

@media (max-width: 560px) {
  .container { width: min(var(--max), calc(100% - 28px)); }
  .hero { padding-bottom: 60px; }
  .section { padding: 70px 0px; }
  .cards, .sector-grid { grid-template-columns: 1fr; }
  .sector:nth-child(2n+1) { padding-right: 0px; border-right: 0px; }
  .sector:nth-child(2n) { padding-left: 0px; }
  .footer-wrap, .copyright { flex-direction: column; }
}

.contact-note a, .contact-direct a { font-weight: 800; }

.contact-direct { margin-top: 18px; }
